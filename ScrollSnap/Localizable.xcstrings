    "whatsNew.highlight.globalShortcut.message" : {
      "comment" : "What's New highlight body for the customizable global shortcut.",
      "extractionState" : "stale",
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apasă ⌃⌥S din orice aplicație pentru a afișa ScrollSnap. Personalizează, resetează sau dezactivează scurtătura în Configurări."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke in einer beliebigen App ⌃⌥S, um ScrollSnap anzuzeigen. Passe die Tastenkombination in den Einstellungen an, setze sie zurück oder deaktiviere sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press ⌃⌥S from any app to show ScrollSnap. Customize, reset, or disable the shortcut in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa ⌃⌥S desde cualquier app para mostrar ScrollSnap. Personaliza, restablece o desactiva el atajo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur ⌃⌥S depuis n’importe quelle app pour afficher ScrollSnap. Personnalisez, réinitialisez ou désactivez le raccourci dans Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのアプリからでも⌃⌥Sを押してScrollSnapを表示できます。設定でショートカットの変更、リセット、無効化ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 앱에서든 ⌃⌥S를 눌러 ScrollSnap을 표시하세요. 설정에서 단축키를 변경하거나 재설정 또는 비활성화할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir uygulamadan ScrollSnap'i göstermek için ⌃⌥S tuşlarına basın. Kısayolu Ayarlar'dan özelleştirebilir, sıfırlayabilir veya devre dışı bırakabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任意应用中按下 ⌃⌥S 即可显示 ScrollSnap。你可以在“设置”中自定义、重置或停用快捷键。"
          }
        }
      }
    },
