    "whatsNew.highlight.backgroundAccess.message" : {
      "comment" : "What's New highlight body for background access and launch at login.",
      "extractionState" : "stale",
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Închiderea interfeței de captură menține acum ScrollSnap în funcțiune. De asemenea, poți lansa aplicația automat la login sau poți deschide Configurări și închide aplicația din meniul Opțiuni."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Schließen der Aufnahmeoberfläche läuft ScrollSnap jetzt weiter. Du kannst die App außerdem bei der Anmeldung automatisch starten sowie über das Menü „Optionen“ die Einstellungen öffnen oder ScrollSnap beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dismissing the capture overlay now keeps ScrollSnap running. You can also launch it automatically when you log in, or open Settings and quit from the Options menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar la superposición de captura, ScrollSnap ahora sigue ejecutándose. También puedes iniciarlo automáticamente al iniciar sesión, abrir Ajustes o salir desde el menú Opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer l’interface de capture laisse désormais ScrollSnap actif. Vous pouvez aussi le lancer automatiquement à l’ouverture de session, ouvrir Réglages ou quitter l’app depuis le menu Options."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャオーバーレイを閉じても、ScrollSnapはバックグラウンドで動作し続けます。ログイン時に自動起動したり、オプションメニューから設定を開いたり終了したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캡처 화면을 닫아도 ScrollSnap은 계속 실행됩니다. 로그인 시 자동 실행을 켤 수 있으며, 옵션 메뉴에서 설정을 열거나 앱을 종료할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalama katmanını kapattığınızda ScrollSnap artık çalışmaya devam eder. Ayrıca oturum açtığınızda otomatik olarak başlatabilir, Seçenekler menüsünden Ayarlar'ı açabilir veya uygulamadan çıkabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭截图浮层后，ScrollSnap 现在会继续运行。你还可以让它在登录时自动启动，或从“选项”菜单打开“设置”和退出应用。"
          }
        }
      }
    },
