    "whatsNew.highlight.captureReliability.message" : {
      "comment" : "What's New highlight body for more reliable scrolling captures.",
      "extractionState" : "stale",
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturile cu derulare includ acum cadrul final și utilizează detectarea îmbunătățită a mișcării și îmbinarea imaginilor, împiedicând încheierea prematură a capturilor lungi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollende Aufnahmen erfassen jetzt auch das letzte Bild und nutzen eine verbesserte Bewegungserkennung und Zusammenfügung, damit lange Screenshots nicht vorzeitig enden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolling captures now include the final frame and use improved motion detection and stitching, preventing long screenshots from ending early."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas con desplazamiento ahora incluyen el fotograma final y usan una detección de movimiento y un ensamblado mejorados, evitando que las capturas largas terminen antes de tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures avec défilement incluent désormais la dernière image et bénéficient d’une détection des mouvements et d’un assemblage améliorés, évitant que les longues captures ne s’arrêtent trop tôt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクロールキャプチャに最後のフレームまで含まれるようになり、動きの検出と画像の結合も改善されたため、長いスクリーンショットが途中で切れるのを防ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 스크롤 캡처가 마지막 프레임까지 포함하며, 움직임 감지와 이미지 연결 정확도가 향상되어 긴 스크린샷이 중간에 잘리는 문제를 방지합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırmalı ekran görüntüleri artık son kareyi de içeriyor ve geliştirilmiş hareket algılama ile birleştirme kullanarak uzun ekran görüntülerinin erken bitmesini önlüyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滚动截图现在会包含最后一帧，并采用改进的移动检测和拼接，避免长截图过早结束。"
          }
        }
      }
    },
