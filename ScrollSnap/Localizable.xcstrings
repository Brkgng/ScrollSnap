    "Please select your Desktop folder to grant ScrollSnap permission to save screenshots there." : {
      "comment" : "Prompt asking the user to choose the Desktop folder for screenshot save access.",
      "extractionState" : "stale",
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selectează dosarul Desktop pentru a permite aplicației ScrollSnap să salveze capturile de ecran acolo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle bitte den Ordner „Schreibtisch“ aus, damit ScrollSnap dort Bildschirmfotos speichern darf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please select your Desktop folder to grant ScrollSnap permission to save screenshots there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona la carpeta Escritorio para permitir que ScrollSnap guarde allí las capturas de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez sélectionner le dossier Bureau afin d’autoriser ScrollSnap à y enregistrer des captures d’écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ScrollSnapがそこにスクリーンショットを保存できるように、デスクトップフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ScrollSnap이 스크린샷을 저장할 수 있도록 데스크탑 폴더를 선택해 주세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ScrollSnap'in ekran görüntülerini oraya kaydetme izni alabilmesi için lütfen Masaüstü klasörünüzü seçin."
